--- a/app/Kconfig
+++ b/app/Kconfig
@@ -725,3 +725,13 @@ osource "$(ZMK_CONFIG)/boards/shields/*/Kconfig.shield"
 rsource "Kconfig.defaults"
 
 source "Kconfig.zephyr"
+
+config OFFSETKEY_USB_RGB_ALWAYS_ON
+    bool "Keep Offsetkey RGB on while USB power is present"
+    depends on SOC_NRF52840 && ZMK_RGB_UNDERGLOW
+    depends on SHIELD_OFFSETKEY_PERIPHERAL_LEFT || SHIELD_OFFSETKEY_PERIPHERAL_RIGHT
+    default y
+    help
+      Read hardware VBUS with USB data disabled. Keep RGB on and prevent
+      deep sleep while powered; restore the battery RGB preference and idle
+      policy when unplugged. Does not change the RGB brightness limit.
