     for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
         pixels[i] = (struct led_rgb){r : 0, g : 0, b : 0};
@@ -327,6 +359,51 @@ static void zmk_rgb_underglow_off_handler(struct k_work *work) {
 
 K_WORK_DEFINE(underglow_off_work, zmk_rgb_underglow_off_handler);
 
+#if IS_ENABLED(CONFIG_OFFSETKEY_USB_RGB_ALWAYS_ON)
+static int offsetkey_rgb_apply(void) {
+    bool powered = offsetkey_usb_power_present();
+    bool active = !IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE) ||
+                  zmk_activity_get_state() == ZMK_ACTIVITY_ACTIVE;
+    bool target = powered || (state.on && active);
+
+    if (!device_is_ready(led_strip)) {
+        return -ENODEV;
+    }
+    if (offsetkey_output_initialized && target == offsetkey_output_on) {
+        return 0;
+    }
+#if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
+    int rc = target ? ext_power_enable(ext_power) : ext_power_disable(ext_power);
+    if (rc < 0) {
+        return rc;
+    }
+#endif
+    offsetkey_output_initialized = true;
+    offsetkey_output_on = target;
+    if (target) {
+        /* Discard a queued blanking frame before starting the animation. */
+        k_work_cancel(&underglow_off_work);
+        state.animation_step = 0;
+        k_timer_start(&underglow_tick, K_NO_WAIT, K_MSEC(50));
+    } else {
+        k_timer_stop(&underglow_tick);
+        k_work_submit_to_queue(zmk_workqueue_lowprio_work_q(), &underglow_off_work);
+    }
+    return 0;
+}
+
+static void offsetkey_power_poll(struct k_work *work) {
+    /* Read VBUS directly: peripheral USB data is intentionally disabled. */
+    offsetkey_rgb_apply();
+    k_work_reschedule(&offsetkey_power_work, K_MSEC(250));
+}
+
+int zmk_rgb_underglow_off(void) {
+    state.on = false;
+    int rc = offsetkey_rgb_apply();
+    return rc < 0 ? rc : zmk_rgb_underglow_save_state();
+}
+#else
 int zmk_rgb_underglow_off(void) {
     if (!led_strip)
         return -ENODEV;
